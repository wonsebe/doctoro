<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="web.model.dao.DeliveryDao">    <!-- mapper start -->

    <!-- 상품 주문 시 배송 테이블에 레코드 등록 -->
    <insert id="deliveryAdd" parameterType="web.model.dto.DeliveryDto">
        insert into delivery (delivery_status, order_no) VALUES (#{delivery_status}, #{order_no});
    </insert>


</mapper>   <!-- mapper end -->